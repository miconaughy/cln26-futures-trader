# Copy this file to .env and fill in your values.
# .env is never committed to git.

# xAI / Grok — get your key at https://console.x.ai
GROK_API_KEY=

# Schwab / ThinkOrSwim — create an app at https://developer.schwab.com
# Callback URL must be set to: https://127.0.0.1
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=

# Your account hash (run get_account_hash.py after first_login.py to find this)
SCHWAB_ACCOUNT_HASH=

# Email alerts — use a Gmail App Password (not your account password)
# Generate one at: https://myaccount.google.com/apppasswords
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
ALERT_EMAIL_PASSWORD=

# Optional — defaults to Gmail if not set
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
